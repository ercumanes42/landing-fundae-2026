# Supabase
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Server-only. Generate at least 32 random bytes; this placeholder is intentionally invalid.
# Never rotate in place: follow data-brain/docs/HUBSPOT_IDEMPOTENCY_CONTRACT.md.
LEAD_HASH_SECRET="replace-with-a-long-random-secret"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL_SUMMARY="gpt-4o-mini"
OPENAI_MODEL_ANALYST="gpt-4o"

# Data Brain dashboard authentication (server-only; never store plaintext passwords)
# JSON v1: PBKDF2-SHA256 >=600000, 16-32 byte base64url salt, 32 byte base64url digest.
# Roles are NOT configured here: dashboard_principals in PostgreSQL is authoritative.
DATA_BRAIN_AUTH_CREDENTIALS='{"version":1,"kdf":{"name":"PBKDF2-SHA256","iterations":600000},"identities":[]}'
DATA_BRAIN_AUTH_PEPPER="replace-with-an-independent-random-secret-of-at-least-32-bytes"
DATA_BRAIN_LEGACY_BASIC_ENABLED=false
DATA_BRAIN_AUTH_MAX_ATTEMPTS=5
DATA_BRAIN_AUTH_WINDOW_SECONDS=300
# Set true only after a distributed edge/WAF rule protects all non-public paths.
DATA_BRAIN_AUTH_EDGE_RATE_LIMITED=false
# Deprecated single-credential variables: keep absent.
DATA_BRAIN_ALLOWED_IPS=""
LANDING_ALLOWED_ORIGINS="https://tu-dominio.com,http://localhost:3001"
# Header set/overwritten by the trusted edge proxy (for example x-vercel-forwarded-for).
# Required in production. Use only a header overwritten by the trusted edge.
# Vercel: x-vercel-forwarded-for. Cloudflare: cf-connecting-ip.
RATE_LIMIT_TRUSTED_IP_HEADER=""

# Campaign security
CAMPAIGN_IMPORT_SECRET="replace-with-a-long-random-secret"
MAKE_WEBHOOK_SECRET="replace-with-a-long-random-secret"
UNSUBSCRIBE_TOKEN_SECRET="replace-with-a-different-random-secret-of-at-least-32-characters"
UNSUBSCRIBE_PUBLIC_BASE_URL="https://data.tu-dominio.com"
# HubSpot app client secret used to validate X-HubSpot-Signature-V3.
HUBSPOT_WEBHOOK_SECRET="replace-with-your-hubspot-app-client-secret"
CAMPAIGN_DEFAULT_EXTERNAL_ID="FUNDAE_2026_EMAIL_V1"

# Delivery and operations
# Master kill switch dominates every outbound lane. All switches default OFF.
OUTBOUND_MASTER_ENABLED=false
# Deprecated Make handoff. Capture never reads or writes its queue.
LEGACY_MAKE_DELIVERY_ENABLED=false
LEGACY_DELIVERY_RETRY_ENABLED=false
# Fixed SHA-256/HMAC identity of the physical Microsoft 365 mailbox; server-side only.
MAILBOX_IDENTITY_HASH=
TRANSACTIONAL_OUTLOOK_ENABLED=false
# Independent cold campaign lane. Keep false until G7+ authorization.
COLD_CAMPAIGN_ENABLED=false
# Provisioning is a separate staging-only gate and must also remain OFF.
COLD_CAMPAIGN_PROVISIONING_ENABLED=false
CAMPAIGN_PROVISION_ACTOR_HASH=
CAMPAIGN_PROVISION_AUTHORIZATION_TOKEN=
# Exact acknowledgement is required only for a directly authorized --apply.
CAMPAIGN_PROVISION_APPLY_ACK=
# Stable UUID for the sole cold scheduler worker.
COLD_CAMPAIGN_WORKER_ID=
# Microsoft Graph app-only runtime. Keep both master and lane false until all gates pass.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
# Object ID/UPN used in the Graph /users/{id} path. It may be a GUID.
GRAPH_MAILBOX_USER_ID=""
# SMTP address asserted in draft from/sender/replyTo and verified before send.
GRAPH_MAILBOX_ADDRESS=""
# Independent >=32-byte secrets for private worker auth and deterministic outbox capabilities.
GRAPH_WORKER_SECRET=""
# Stable UUID for the single durable dispatch worker; not a secret.
GRAPH_DISPATCH_WORKER_ID=""
GRAPH_OUTBOX_CAPABILITY_SECRET=""
GRAPH_REQUEST_TIMEOUT_MS="10000"
GRAPH_READ_MAX_ATTEMPTS="4"
# A Retry-After above this job budget is deferred/halted; it is never shortened.
GRAPH_MAX_RETRY_DELAY_MS="30000"
GRAPH_MARKER_POLL_ATTEMPTS="4"
GRAPH_SENT_POLL_ATTEMPTS="10"
GRAPH_POLL_INTERVAL_MS="2000"
# Independent inbound facts lane. Keep OFF until mailbox delta/cursor gates pass.
INBOUND_MAILBOX_ENABLED=false
# Required ISO timestamp for the first created-only Inbox delta run; never defaults to full history.
INBOUND_MAILBOX_BOOTSTRAP_FROM=""
# Calendly is independent from outbound and remains OFF until signature/webhook gates pass.
CALENDLY_WEBHOOK_ENABLED=false
CALENDLY_WEBHOOK_SIGNING_KEY=""
TRANSACTIONAL_PILOT_MODE=true
# Comma-separated server-derived lead_id hashes for the four internal pilot recipients; never emails.
TRANSACTIONAL_PILOT_ALLOWLIST_LEAD_IDS=
TRANSACTIONAL_LANDING_ORIGIN="https://landing-fundae-2026.vercel.app"
TRANSACTIONAL_WEBINAR_TITLE=""
TRANSACTIONAL_WEBINAR_START_AT=""
TRANSACTIONAL_WEBINAR_DURATION_MINUTES="45"
TRANSACTIONAL_WEBINAR_TIMEZONE="Europe/Madrid"
TRANSACTIONAL_WEBINAR_ACCESS_NOTE=""
MAKE_WEBHOOK_URL=""
AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""
POSTHOG_PROJECT_API_KEY=""
NOTIFICATION_WEBHOOK_URL=""

# HubSpot CRM
HUBSPOT_ACCESS_TOKEN=""
HUBSPOT_PORTAL_ID=""
HUBSPOT_API_VERSION="2026-03"
HUBSPOT_SYNC_ENABLED=false
OPERATIONAL_OBSERVABILITY_ENABLED=false
OPERATIONAL_ALERT_DELIVERY_ENABLED=false
OBSERVABILITY_WORKER_SECRET=""
