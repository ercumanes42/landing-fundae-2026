{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "build": "vite build",
    "build:vercel": "node scripts/release/legal-deploy-gate.mjs --vercel-production && vite build",
    "preview": "vite preview",
    "clean": "node scripts/release/clean.mjs",
    "clean:dry-run": "node scripts/release/clean.mjs --dry-run",
    "lint": "tsc --noEmit",
    "campaign:validate": "node automation/scripts/validate-campaign.mjs",
    "campaign:tracking": "node automation/scripts/test-tracking-urls.mjs",
    "campaign:rebalance": "node automation/scripts/rebalance-report.mjs",
    "campaign:import": "node automation/scripts/import-campaign.mjs",
    "campaign:provision:dry-run": "node automation/scripts/provision-cold-campaign.mjs",
    "campaign:provision:materialized:dry-run": "node automation/scripts/provision-cold-campaign.mjs --materialized",
    "campaign:provision:apply": "node automation/scripts/provision-cold-campaign.mjs --apply",
    "campaign:exclusions:check": "node automation/scripts/materialize-campaign-exclusions.mjs",
    "campaign:exclusions:build-snapshots": "node automation/scripts/materialize-campaign-exclusions.mjs --build-signed-snapshots",
    "campaign:exclusions:materialize": "node automation/scripts/materialize-campaign-exclusions.mjs --materialize-private-copy",
    "test:e2e": "npm run build && playwright test",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "campaign:unsubscribe:prepare": "node automation/scripts/prepare-operational-workbook.mjs",
    "campaign:unsubscribe:test": "node --test automation/scripts/unsubscribe-operations.test.mjs automation/scripts/campaign-readiness-legal.test.mjs",
    "email:transactional:test": "node --test automation/scripts/transactional-email-matrix.test.mjs",
    "test:automation": "node --test automation/scripts/campaign-readiness-legal.test.mjs automation/scripts/materialize-campaign-exclusions.test.mjs automation/scripts/provision-cold-campaign.test.mjs automation/scripts/prepare-operational-workbook.test.mjs automation/scripts/make-spec.test.mjs automation/scripts/repair-transactional-make-m10.test.mjs automation/scripts/transactional-email-matrix.test.mjs automation/scripts/transactional-gate-b-runtime-contract.test.mjs automation/scripts/transactional-gate-b-runtime.test.mjs automation/scripts/unsubscribe-operations.test.mjs automation/scripts/validate-transactional-make-outlook.test.mjs automation/scripts/validate-transactional-make-v3.test.mjs",
    "release:manifest": "node scripts/release/baseline-manifest.mjs",
    "release:manifest:verify": "node scripts/release/verify-manifest.mjs",
    "release:candidate:dry-run": "node scripts/release/plan-release-candidate.mjs",
    "test:release-candidate": "node --test scripts/release/release-candidate-plan.test.mjs scripts/release/release-ci-contract.test.mjs",
    "test:release-deploy-gate": "node --test scripts/release/legal-deploy-gate.test.mjs",
    "release:deploy:gate": "node scripts/release/legal-deploy-gate.mjs",
    "release:ci-pins": "node scripts/release/verify-ci-pins.mjs",
    "test:supabase-gate-pack": "node --test scripts/release/supabase-gate-pack.test.mjs",
    "release:supabase:gates:static": "node scripts/release/run-supabase-static-gates.mjs",
    "verify:release": "node scripts/release/verify-release.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  }
}
