{
  "name": "FUNDAE 2026 Campaign Scheduler",
  "kind": "configuration-spec",
  "importable": false,
  "production_ready": false,
  "enabled": false,
  "reason": "The exact Make HTTP module slug, scenario ID, connection and secret mapping were not verified in an authorized Make team. This file must not be imported or activated.",
  "authority": {
    "campaign_state": "Data Brain/PostgreSQL",
    "scheduler_only": "Make",
    "one_tick_one_transition": true
  },
  "scenario": {
    "schedule": { "type": "indefinitely", "interval_seconds": 60, "timezone": "Europe/Madrid" },
    "maximum_concurrent_executions": 1,
    "modules": [
      {
        "position": 1,
        "app": "HTTP",
        "module": "UNVERIFIED_EXACT_SLUG",
        "label": "POST one private Data Brain campaign tick",
        "method": "POST",
        "endpoint": "/api/internal/graph/campaign-dispatch",
        "body": null,
        "headers": ["Authorization: Bearer <secret mapping>", "Content-Length: 0"],
        "timeout_seconds": 55
      }
    ]
  },
  "response_contract": {
    "fields": ["accepted", "state", "reason_code", "dispatch_id", "reservation_id", "alert_attempted", "alert_delivered"],
    "success_states": ["empty", "confirmed_sent"],
    "deferred_states": ["off", "deferred"],
    "halt_states": ["ambiguous_halted"],
    "never_retry_blindly": true,
    "http_status_policy": {
      "200": "complete_execution_without_retry",
      "409": "controlled_no_progress_wait_for_next_scheduled_tick",
      "503": "halt_execution_create_incomplete_execution_and_alert_operator"
    },
    "retry_policy": {
      "automatic_retries": 0,
      "incomplete_executions": true,
      "retry_requires_operator_review": true
    }
  },
  "database_gates": {
    "outbound_master": false,
    "cold_campaign": false,
    "minimum_spacing_seconds": 60,
    "maximum_daily_send_submitted": 480,
    "timezone": "Europe/Madrid",
    "terminal_stops": ["reply_human", "unsubscribe", "opposition", "hard_bounce", "suppression", "duplicate", "meeting"]
  },
  "verification_required": [
    "Select the Make team and exact HTTP module using app_modules_list",
    "Select the connection interactively and validate its scope",
    "Validate the module and blueprint schema",
    "Create inactive, verify OFF response with zero Graph traffic, then keep inactive",
    "Do not activate without campaign gates and direct user authorization"
  ]
}
